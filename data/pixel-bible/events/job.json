      "id": "ot-voice-35",
      "code": "job",
      "chapter": 2,
      "title": "욥은 질그릇 조각으로 몸을 긁으며 고통을 견뎌",
      "actors": [
        "욥"
      ],
      "object": "pot",
      "ref": "욥기 2:8-10",
      "verseNumbers": [
        8,
        9,
        10
      ],
      "actions": {},
      "lines": [
        "욥(창작·본문 기반): 이 고난 속에서도 내 입술로 하나님을 거역하지 말자.",
        "해설: 욥은 질그릇 조각으로 몸을 긁으며 고통을 견뎌요. 온전한 그릇 그림은 조각의 상징이며 질병의 책임을 환자에게 돌리지 않아요."
      ],
      "study": "욥은 질그릇 조각으로 몸을 긁으며 고통을 견뎌요. 온전한 그릇 그림은 조각의 상징이며 질병의 책임을 환자에게 돌리지 않아요.",
      "actorLines": {
        "욥": [
          "이 고난 속에서도 내 입술로 하나님을 거역하지 말자."
        ]
      },
      "narrationOnly": false,
      "objectNote": "본문을 근거로 직접 쓴 창작 발화예요. 도구는 장면의 상징 배치일 수 있으며, 모든 동작을 전용 애니메이션으로 재현한 것은 아니에요.",
      "animation": {"version":2,"motif":"scratch","lead":"욥","target":null,"mode":"reconstruction","setting":"desert","effect":"potsherd","emotion":"sad","prop":"pot","beats":[{"action":"sit","duration":1,"actor":"욥"},{"action":"reach","duration":1.2,"actor":"욥"},{"action":"scratch","duration":1.5,"actor":"욥"},{"action":"wait","duration":1.8,"actor":"욥"},{"action":"scratch","duration":1.5,"actor":"욥"},{"action":"lower","duration":1.2,"actor":"욥"}],"duration":8.2,"support":null,"ref":"욥기 2:8-10","source":"본문 기반 재구성 · 세부 자세와 시간은 창작"}
