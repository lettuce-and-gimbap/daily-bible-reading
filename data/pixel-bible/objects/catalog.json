    "salt-bowl": {
      "id": "salt-bowl",
      "name": "소금 담은 새 그릇",
      "family": "vessel",
      "action": "water",
      "aliases": [
        "소금을 담아",
        "소금을 담은",
        "새 그릇"
      ],
      "description": "엘리사가 새 그릇에 담아 오게 한 소금을 나타내요. 물의 회복을 소금 자체의 보편적인 정수 능력으로 설명하지 않아요.",
      "descriptionRefs": [
        "열왕기하 2:20–22"
      ]
    },
    "flour-bowl": {
      "id": "flour-bowl",
      "name": "가루 그릇",
      "family": "vessel",
      "action": "oil",
      "aliases": [
        "가루를 가져",
        "가루 그릇"
      ],
      "description": "독이 있다고 외친 국에 엘리사가 넣게 한 가루를 담은 상징 그릇이에요. 본문은 이 가루의 재료나 용기 모양을 확정하지 않아요.",
      "descriptionRefs": [
        "열왕기하 4:40–41"
      ]
    },
    "fig-poultice": {
      "id": "fig-poultice",
      "name": "무화과 반죽 찜질",
      "family": "food",
      "action": "field",
      "aliases": [
        "무화과 반죽",
        "무화과로 만든 연고"
      ],
      "description": "히스기야의 종처에 붙인 무화과 반죽을 나타내요. 오늘날 모든 질병에 적용하는 치료 지침은 아니에요.",
      "descriptionRefs": [
        "열왕기하 20:7"
      ]
    },
    "alabaster-jar": {
      "id": "alabaster-jar",
      "name": "향유 옥합",
      "family": "vessel",
      "action": "oil",
      "aliases": [
        "옥합"
      ],
      "description": "향유를 담은 옥합을 향유 자체와 구분한 도안이에요. 본문의 재질과 개봉 동작을 참고하되 정확한 유물 복원이라고 주장하지 않아요.",
      "descriptionRefs": [
        "마가복음 14:3"
      ]
    },
    "reed-basket": {
      "id": "reed-basket",
      "name": "갈대 상자",
      "family": "basket",
      "action": "field",
      "aliases": [
        "갈대 상자",
        "갈대상자"
      ],
      "description": "아기 모세를 위해 갈대로 엮고 방수한 상자를 표현해요. 평범한 수확 바구니와 구분해 덮개와 엮임을 그렸어요.",
      "descriptionRefs": [
        "출애굽기 2:3"
      ]
    },
    "writing-tablet": {
      "id": "writing-tablet",
      "name": "글 쓰는 토판",
